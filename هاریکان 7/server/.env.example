# پورت سرور
PORT=3000
# یک رشته تصادفی و طولانی (مثلاً خروجی: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
# مدت اعتبار ورود
JWT_TTL=30d
# مسیر فایل دیتابیس
DB_FILE=./data/aromin.db
# مدیر اولیه (فقط بار اول ساخته می‌شود)
ADMIN_USER=admin
ADMIN_PASS=change-this-password
# موبایل مدیر برای پیامک «درخواست جدید»
MANAGER_MOBILE=
# 1 = پیامک‌ها فقط در لاگ چاپ شوند (برای تست)
SMS_DRY_RUN=0

# ───────── دستگاه حضور و غیاب (سرویس zk-sync روی همین سرور)
# آدرس داخلی سرویس تخلیه دستگاه — خالی = بخش دستگاه‌ها غیرفعال
ZK_SERVICE_URL=http://127.0.0.1:8470/api
# همان مقدار AZK_API_KEY در فایل /etc/aromin-zk/aromin-zk.env
ZK_SERVICE_KEY=
# هر چند ثانیه رکوردهای تازه دستگاه به کارکرد منتقل شود
ZK_BRIDGE_SEC=30
