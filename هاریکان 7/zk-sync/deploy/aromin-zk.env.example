# /etc/aromin-zk/aromin-zk.env
AZK_DB_PATH=/var/lib/aromin-zk/attendance.db
# کلید API — یک رشته تصادفی طولانی بگذارید و همین را در صفحه داشبورد وارد کنید
AZK_API_KEY=CHANGE_ME
AZK_HOST=127.0.0.1
AZK_PORT=8470
# دامنه‌هایی که اجازه دارند از مرورگر به API درخواست بدهند (با کاما جدا کنید)
AZK_CORS_ORIGINS=https://dashboard.arominco.com
# هر چند ثانیه زمان‌بند بررسی کند (پیش‌فرض ۲۰)
AZK_SCHEDULER_TICK=20
AZK_MAX_PARALLEL=4
# ساعت موظفی روزانه به دقیقه (۷:۳۰ = ۴۵۰)
AZK_STANDARD_WORK_MIN=450
# pyzk = دستگاه واقعی | fake = شبیه‌ساز برای تست
AZK_DRIVER=pyzk
