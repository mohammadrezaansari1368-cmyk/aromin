# AROMIN AI Agent — environment configuration
# Copy to .env for local development. Never commit real values.
# Every value below is a placeholder or a safe development default.

# --- application ---------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_NAME=aromin-agent
APP_VERSION=0.1.0

# --- database (PostgreSQL in staging/production; SQLite allowed only for dev/test) ---
DATABASE_URL=sqlite+aiosqlite:///./aromin_agent.db
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# --- redis (cache, rate limits, SSE fan-out; optional in Phase 1) ---------------
REDIS_URL=
# REDIS_URL=redis://<host>:6379/0

# --- LLM provider ----------------------------------------------------------------
LLM_PROVIDER=mock                   # mock | openai_compatible | arvan
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_SMALL=mock-small
LLM_MODEL_MAIN=mock-main
LLM_MODEL_LARGE=mock-large
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1024
# Arvan adapter refuses to start until its API is verified (blueprint §15 checklist)
ARVAN_API_VERIFIED=false
ALLOW_MOCK_PROVIDER_IN_PRODUCTION=false

# --- API authentication / security ----------------------------------------------
# API keys are created with `python -m app.cli create-api-key` and stored hashed in the DB.
API_KEY_PREFIX=ak
RATE_LIMIT_CHAT_PER_MINUTE=30
CORS_ALLOWED_ORIGINS=[]

# --- logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console

# --- task workers (Task Engine phase; reserved) ----------------------------------
WORKER_CONCURRENCY=16
TASK_LEASE_SECONDS=60

# --- web search (later phase; unused in Phase 1) ---------------------------------
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# --- SMS (later phase; sending is disabled and cannot be enabled in Phase 1) -----
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDING_ENABLED=false
