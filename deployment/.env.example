# Scheduled publishing is disabled until authenticated settings explicitly enable it.
TELEGRAM_ADMIN_ID=71157396
TELEGRAM_CHANNEL=-1001005246727
TELEGRAM_CHANNEL_USERNAME=aromin_online
COMPOSIO_API_KEY=
COMPOSIO_TG_ACCOUNT=
COMPOSIO_USER_ID=
BALE_BOT_TOKEN=
BALE_CHANNEL_ID=
BALE_API_BASE=https://tapi.bale.ai
# Requires a Composio Platform connection; a For You connection is insufficient.
COMPOSIO_IG_ACCOUNT=
COMPOSIO_IG_USER_ID=
INSTAGRAM_IG_USER_ID=
PUBLIC_BASE_URL=https://dashboard.arominco.com
# Empty means <server directory>/media/pub and vendored Vazirmatn OFL fonts.
PUB_MEDIA_DIR=
PUB_FONT_DIR=
# Settings API defaults: enabled=false, preparation_time=null, publishing_time=null,
# destinations=[], approval_mode=manual, late_approval_policy=defer,
# rotation={cooldown_days:30,exclude_urls:[],exclude_keywords:[],priority_urls:[],require_in_stock:true},
# story_show_price=false, price_max_age_minutes=60,
# cost_limits={max_ai_calls_per_run:2,max_product_fetches_per_run:15,max_image_api_calls_per_run:0}.
# WhatsApp Channels always BLOCKED: no verified WhatsApp Channels API.
# اعلانِ لید در تلگرام و بله (کارشناسِ تخصیص‌یافته + مدیرِ فروش). خالی → TELEGRAM_BOT_TOKEN/Composio و BALE_BOT_TOKEN
TELEGRAM_LEADS_BOT_TOKEN=
TELEGRAM_LEADS_BOT_USERNAME=arominagent_bot
# Telegram API base: keep the official default, or point to a relay/proxy if api.telegram.org is unreachable from the server.
TELEGRAM_API_BASE=https://api.telegram.org
# Live checks only (agent_live_check.py): test chats that receive one test message; never real recipients.
TELEGRAM_TEST_CHAT_ID=
BALE_TEST_CHAT_ID=
# Rate-limit IP: `ar-real-ip` (ArvanCloud, github.com/arvancloud/ar-ngxrealip) is trusted only from these edges; empty = built-in list
# from https://www.arvancloud.ir/fa/ips.txt (2026-10-21). Local nginx must send: proxy_set_header X-Real-IP $remote_addr;
#TRUSTED_EDGE_PROXIES=185.143.232.0/22,185.215.232.0/22
#TRUSTED_LOCAL_PROXIES=127.0.0.0/8,::1/128
# Whole visitor turn (knowledge + search + all model rounds); after it the visitor gets the Persian fallback.
#AGENT_TURN_BUDGET_SEC=25
BALE_LEADS_BOT_TOKEN=
BALE_LEADS_BOT_USERNAME=arominbot
# اختیاری: regexِ پاسخِ موفقِ نبض‌کار اگر قالبِ پاسخِ پنل چیزی جز شناسهٔ عددیِ مثبت است
NABZEKAR_OK_REGEX=
# دستیارِ آرومین: شناسهٔ مدلِ fine-tuneشده (اختیاری؛ خالی → AI_MODEL). آموزش فقط با تأییدِ صریحِ کاربر و بیرون از این سرور.
AGENT_FT_MODEL=
# POST /api/bot/answer (سرور-به-سرور): حداقل ۳۲ کاراکتر؛ خالی = این مسیر همیشه رد می‌شود (نه خطای راه‌اندازی).
BOT_ANSWER_KEY=
BOT_ANSWER_SITE_ID=
# نشست‌های امضاشده (WP-01): خالی → کلیدِ تصادفی در .assistant-secrets/session.key ساخته و نگه داشته می‌شود (هر ری‌استارت پایدار است).
AROMIN_SESSION_SECRET=
